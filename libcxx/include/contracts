        & contracts::evaluation_semantic_set(__r.allowed_semantics)) {}
};

// Group-name merging for combined labels.
//
// D3400R5 says a combined label's group_names is the sorted, unique union of
// its constituents'.  The result is computed once into this mutable buffer and
// then copied into the const member through a pack expansion: a const array
// cannot be sorted in place, and an array cannot be returned by value, so the
// buffer is what carries the answer out of the merge.
//
// The extent is a type-level upper bound (the sum of the constituents'
// counts), because the number of *distinct* names depends on values the
// constructor cannot see at class scope.  Duplicates therefore leave empty
// rows at the end, which every consumer skips.
template<unsigned _Nm, unsigned _Ml>
struct __gn_buf {
  char __a[_Nm][_Ml] = {};
};

constexpr int __gn_cmp(const char* __x, const char* __y) {
  while (*__x && *__x == *__y) {
    ++__x;
    ++__y;
  }
  return (int)(unsigned char)*__x - (int)(unsigned char)*__y;
}

// Append every row of __t.group_names to __b at __n; return the new count.
template<unsigned _Nm, unsigned _Ml, typename _Tp>
constexpr unsigned __gn_append(__gn_buf<_Nm, _Ml>& __b, unsigned __n,
                               const _Tp& __t) {
  for (unsigned __i = 0; __i < __group_count<_Tp>; ++__i, ++__n)
    for (unsigned __j = 0; __j < __group_max_len<_Tp> && __j < _Ml; ++__j)
      __b.__a[__n][__j] = __t.group_names[__i][__j];
  return __n;
}

template<unsigned _Nm, unsigned _Ml>
constexpr void __gn_sort_unique(__gn_buf<_Nm, _Ml>& __b, unsigned __n) {
  for (unsigned __i = 1; __i < __n; ++__i)
    for (unsigned __j = __i;
         __j > 0 && __gn_cmp(__b.__a[__j - 1], __b.__a[__j]) > 0; --__j)
      for (unsigned __k = 0; __k < _Ml; ++__k) {
        char __t = __b.__a[__j - 1][__k];
        __b.__a[__j - 1][__k] = __b.__a[__j][__k];
        __b.__a[__j][__k] = __t;
      }

  unsigned __w = 0;
  for (unsigned __i = 0; __i < __n; ++__i)
    if (__i == 0 || __gn_cmp(__b.__a[__i], __b.__a[__w - 1]) != 0) {
      if (__w != __i)
        for (unsigned __k = 0; __k < _Ml; ++__k)
          __b.__a[__w][__k] = __b.__a[__i][__k];
      ++__w;
    }
  for (unsigned __i = __w; __i < __n; ++__i)
    for (unsigned __k = 0; __k < _Ml; ++__k)
      __b.__a[__i][__k] = '\0';
}

template<typename _Lhs, typename _Rhs>
struct __combined_identification_label {
  constexpr __combined_identification_label(const _Lhs&, const _Rhs&) {}
};

template<typename _Lhs, typename _Rhs>
  requires identification_label<_Lhs>
struct __combined_identification_label<_Lhs, _Rhs> {
  static constexpr unsigned __lc = __group_count<_Lhs>;
  static constexpr unsigned __ml = __group_max_len<_Lhs>;
  const char group_names[__lc][__ml];

  constexpr __combined_identification_label(const _Lhs& __l, const _Rhs&)
    : __combined_identification_label(__merge(__l),
                                      __make_gn_seq<__lc * __ml>{}) {}

private:
  static constexpr __gn_buf<__lc, __ml> __merge(const _Lhs& __l) {
    __gn_buf<__lc, __ml> __b;
    __gn_sort_unique(__b, __gn_append(__b, 0u, __l));
    return __b;
  }

  template<unsigned... _I>
  constexpr __combined_identification_label(const __gn_buf<__lc, __ml>& __b,
                                            __gn_seq<unsigned, _I...>)
    : group_names{__b.__a[_I / __ml][_I % __ml]...} {}
};

template<typename _Lhs, typename _Rhs>
  requires identification_label<_Rhs>
struct __combined_identification_label<_Lhs, _Rhs> {
  static constexpr unsigned __rc = __group_count<_Rhs>;
  static constexpr unsigned __ml = __group_max_len<_Rhs>;
  const char group_names[__rc][__ml];

  constexpr __combined_identification_label(const _Lhs&, const _Rhs& __r)
    : __combined_identification_label(__merge(__r),
                                      __make_gn_seq<__rc * __ml>{}) {}

private:
  static constexpr __gn_buf<__rc, __ml> __merge(const _Rhs& __r) {
    __gn_buf<__rc, __ml> __b;
    __gn_sort_unique(__b, __gn_append(__b, 0u, __r));
    return __b;
  }

  template<unsigned... _I>
  constexpr __combined_identification_label(const __gn_buf<__rc, __ml>& __b,
                                            __gn_seq<unsigned, _I...>)
    : group_names{__b.__a[_I / __ml][_I % __ml]...} {}
};

template<typename _Lhs, typename _Rhs>
  requires identification_label<_Lhs> && identification_label<_Rhs>
struct __combined_identification_label<_Lhs, _Rhs> {
  static constexpr unsigned __lc = __group_count<_Lhs>;
  static constexpr unsigned __rc = __group_count<_Rhs>;
  static constexpr unsigned __tc = __lc + __rc;
  static constexpr unsigned __ml =
    __group_max_len<_Lhs> > __group_max_len<_Rhs>
      ? __group_max_len<_Lhs> : __group_max_len<_Rhs>;
  const char group_names[__tc][__ml];

  constexpr __combined_identification_label(const _Lhs& __l, const _Rhs& __r)
    : __combined_identification_label(__merge(__l, __r),
                                      __make_gn_seq<__tc * __ml>{}) {}

private:
  static constexpr __gn_buf<__tc, __ml> __merge(const _Lhs& __l,
                                                const _Rhs& __r) {
    __gn_buf<__tc, __ml> __b;
    unsigned __n = __gn_append(__b, 0u, __l);
    __gn_sort_unique(__b, __gn_append(__b, __n, __r));
    return __b;
  }

  template<unsigned... _I>
  constexpr __combined_identification_label(const __gn_buf<__tc, __ml>& __b,
                                            __gn_seq<unsigned, _I...>)
    : group_names{__b.__a[_I / __ml][_I % __ml]...} {}
};

template<typename _Lhs, typename _Rhs>
  requires requires { typename _Lhs::assertion_control_object;
                      typename _Rhs::assertion_control_object; }
struct __combined_label
  : __combined_allowed_semantics_label<_Lhs, _Rhs>
  , __combined_identification_label<_Lhs, _Rhs>
{
  using assertion_control_object = __combined_label;

  constexpr __combined_label(const _Lhs& __lhs, const _Rhs& __rhs)
    : __combined_allowed_semantics_label<_Lhs, _Rhs>(__lhs, __rhs),
      __combined_identification_label<_Lhs, _Rhs>(__lhs, __rhs),
      _M_lhs(__lhs), _M_rhs(__rhs) {}

  constexpr __combined_label(const __combined_label&) = default;

  constexpr contracts::evaluation_semantic
  compute_semantic(contracts::evaluation_semantic __s) const
    requires (semantic_computation_label<_Lhs>
              || semantic_computation_label<_Rhs>)
  {
    if constexpr (semantic_computation_label<_Lhs>)
      __s = _M_lhs.compute_semantic(__s);
    if constexpr (semantic_computation_label<_Rhs>)
      __s = _M_rhs.compute_semantic(__s);
    return __s;
  }

  constexpr const char*
  compute_comment(const char* __c) const
    requires (compute_comment_label<_Lhs> || compute_comment_label<_Rhs>)
  {
    if constexpr (compute_comment_label<_Lhs>)
      __c = _M_lhs.compute_comment(__c);
    if constexpr (compute_comment_label<_Rhs>)
      __c = _M_rhs.compute_comment(__c);
    return __c;
  }

  constexpr const char*
  compute_message(const char* __m) const
    requires (compute_message_label<_Lhs> || compute_message_label<_Rhs>)
  {
    if constexpr (compute_message_label<_Lhs>)
      __m = _M_lhs.compute_message(__m);
    if constexpr (compute_message_label<_Rhs>)
      __m = _M_rhs.compute_message(__m);
    return __m;
  }

  contracts::violation_handled
  handle_contract_violation(const contracts::contract_violation& __v) const
    requires (local_violation_label<_Lhs> || local_violation_label<_Rhs>)
  {
    // A handler may return void, in which case it never claims the violation
    // and the next component still runs.  The void case has to be split off
    // before the declaration: `auto __r = <void expression>' is ill-formed, so
    // testing decltype(__r) afterwards is too late.
    if constexpr (local_violation_label<_Lhs>) {
      using _Ret = decltype(_M_lhs.handle_contract_violation(__v));
      if constexpr (__is_same(_Ret, void))
        _M_lhs.handle_contract_violation(__v);
      else if (static_cast<contracts::violation_handled>(
                 _M_lhs.handle_contract_violation(__v))
               == contracts::violation_handled::handled)
        return contracts::violation_handled::handled;
    }
    if constexpr (local_violation_label<_Rhs>) {
      using _Ret = decltype(_M_rhs.handle_contract_violation(__v));
      if constexpr (__is_same(_Ret, void))
        _M_rhs.handle_contract_violation(__v);
      else if (static_cast<contracts::violation_handled>(
                 _M_rhs.handle_contract_violation(__v))
               == contracts::violation_handled::handled)
        return contracts::violation_handled::handled;
    }
    return contracts::violation_handled::not_handled;
  }

  void* query(const void* __key, std::size_t __index = 0) const
    requires (queryable_label<_Lhs> || queryable_label<_Rhs>)
  {
    if constexpr (queryable_label<_Lhs> && queryable_label<_Rhs>) {
      void* __r = _M_lhs.query(__key, __index);
      if (__r) return __r;
      std::size_t __lhs_count = 0;
      if (_M_lhs.query(__key, 0)) {
        std::size_t __lo = 0, __hi = __index;
        while (__lo + 1 < __hi) {
          std::size_t __mid = __lo + ((__hi - __lo) >> 1);
          if (_M_lhs.query(__key, __mid)) __lo = __mid;
          else __hi = __mid;
        }
        __lhs_count = __lo + 1;
      }
      return _M_rhs.query(__key, __index - __lhs_count);
    } else if constexpr (queryable_label<_Lhs>)
      return _M_lhs.query(__key, __index);
    else
      return _M_rhs.query(__key, __index);
  }

  _Lhs _M_lhs;
  _Rhs _M_rhs;
};

template<typename _Lhs, typename _Rhs>
  requires requires { typename _Lhs::assertion_control_object;
                      typename _Rhs::assertion_control_object; }
constexpr auto
operator|(const _Lhs& __lhs, const _Rhs& __rhs)
{ return __combined_label<_Lhs, _Rhs>(__lhs, __rhs); }

