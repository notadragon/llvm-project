inline void handle_observed_contract_violation(
    const char* __comment,
    const std::source_location &__loc = std::source_location::current()) {
  __handle_manual_contract_violation(assertion_kind::manual,
                                     evaluation_semantic::observe, detection_mode::unspecified,
                                     __comment, __loc,
                                     /*__can_throw=*/true);
}

[[noreturn]]  inline void handle_enforced_contract_violation(
    const char* __comment,
    const std::source_location &__loc = std::source_location::current()) {
  __handle_manual_contract_violation(assertion_kind::manual,
                                     evaluation_semantic::enforce, detection_mode::unspecified,
                                     __comment, __loc, /*__can_throw=*/true);
  __libcpp_unreachable();
}

[[noreturn]] inline void handle_quick_enforced_contract_violation(
    const char* __comment,
    const std::source_location& __loc = std::source_location::current()
    ) noexcept {
  (void)__comment;
  (void)__loc;
  __builtin_trap();
  __libcpp_unreachable();
}

// D4298: the nothrow_t overloads report the *noexcept* evaluation semantics
// only when the calling translation unit was compiled with -fcontracts-p4298
// (which predefines __cpp_contracts_nonthrowing_semantics).  To make this a
// per-caller-TU decision without an ODR violation, the P4298 variants live in
// the inline namespace std::contracts::__p4298: a caller with the flag binds
// std::contracts::handle_*_contract_violation (via the inline namespace) to
// the distinct mangled symbol std::contracts::__p4298::handle_*_contract_
// violation (reporting noexcept_enforce/noexcept_observe), while a caller
// without the flag binds the plain std::contracts symbol (reporting
// enforce/observe).  Because a given TU compiles exactly one of the two
// variants (the macro selects both the namespace and the reported semantic),
// each mangled name has exactly one definition across all TUs -- so a
// mixed-flag program is well-formed and a non-inlined call lands on the
// symbol matching the caller's own flag.
#ifdef __cpp_contracts_nonthrowing_semantics
inline namespace __p4298 {
#endif

inline void handle_observed_contract_violation(
    nothrow_t,
    const char* __comment,
    const std::source_location& __loc = std::source_location::current()) noexcept {
  __handle_manual_contract_violation(assertion_kind::manual,
#ifdef __cpp_contracts_nonthrowing_semantics
      evaluation_semantic::noexcept_observe,
#else
      evaluation_semantic::observe,
#endif
      detection_mode::unspecified, __comment, __loc, /*__can_throw=*/false);
}

[[noreturn]] inline void handle_enforced_contract_violation(
    std::nothrow_t,
    const char* __comment,
    const std::source_location& __loc = std::source_location::current()
    ) noexcept {
  __handle_manual_contract_violation(assertion_kind::manual,
#ifdef __cpp_contracts_nonthrowing_semantics
      evaluation_semantic::noexcept_enforce,
#else
      evaluation_semantic::enforce,
#endif
      detection_mode::unspecified, __comment, __loc, /*__can_throw=*/false);
  __libcpp_unreachable();
}

#ifdef __cpp_contracts_nonthrowing_semantics
} // inline namespace __p4298
#endif

} // namespace std::contracts
