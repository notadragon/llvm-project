/*
    cassert synopsis

Macros:

    assert

*/

#if __cplusplus < 201103L && defined(_LIBCPP_USE_FROZEN_CXX03_HEADERS)
#  include <__cxx03/cassert>
#else
#  include <__config>
#  include <version>

// libc++ provides <assert.h> as a wrapper around the C library header.  Include
// it first so the C definition of `assert` is in place before the P3290
// integration (in <__cassert/assert_contract.h>) redefines it.
#  if __has_include(<assert.h>)
#    include <assert.h>
#  endif

#  if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#    pragma GCC system_header
#  endif

// P3290 assert integration and its feature-test macro, shared with <assert.h>.
// This header has no include guard so `assert` is redefined per current NDEBUG.
#  include <__cassert/assert_contract.h>

#endif // __cplusplus < 201103L && defined(_LIBCPP_USE_FROZEN_CXX03_HEADERS)
